# ─────────────────────────────────────────────
# App
# ─────────────────────────────────────────────
NODE_ENV=development
PORT=5000
API_VERSION=v1
CLIENT_URL=http://localhost:3000

# ─────────────────────────────────────────────
# Database (Phase 2)
# ─────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/peerprep

# ─────────────────────────────────────────────
# JWT / Auth (Phase 7)
# ─────────────────────────────────────────────
JWT_ACCESS_SECRET=replace_with_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=replace_with_another_long_random_string

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# Email (verification / password reset) — Phase 7
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="PeerPrep AI <no-reply@peerprep.ai>"

# ─────────────────────────────────────────────
# AI — Gemini (Phase 13)
# ─────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ─────────────────────────────────────────────
# Cloudinary (Phase 15)
# ─────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─────────────────────────────────────────────
# Rate limiting / security (Phase 5)
# ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
